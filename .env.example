# Optional; normal runs use the country returned by Epic OAuth.
EPIC_COUNTRY=CA
EPIC_LOCALE=en-US

# Set this if Patchright's bundled Chromium is unavailable on your Pi.
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

# Browser fallback / human intervention.
BROWSER_HUMAN_TIMEOUT_MS=900000
REMOTE_ASSIST_PORT=6080
REMOTE_ASSIST_BIND=0.0.0.0
VNC_PASSWORD=change-this-password
# Public/Tailscale URL opened from the phone notification.
# Example: http://pi5:6080/vnc.html?autoconnect=true&resize=remote
REMOTE_ASSIST_URL=

# Phone notifications. Install the ntfy app and subscribe to a private topic.
# Example: https://ntfy.sh/replace-with-a-long-random-topic
NTFY_URL=
