[Unit]
Description=Claim Epic free games (API first, browser fallback)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=NODE_ENV=production
EnvironmentFile=-__INSTALL_DIR__/.env
ExecStart=/usr/bin/env npm run claim
Nice=10
# Xvfb creates its Unix-domain X11 socket under /tmp/.X11-unix. A private
# /tmp can prevent an unprivileged Xvfb from creating/using that socket on
# some systemd/Debian configurations, so keep the normal host /tmp here.
PrivateTmp=false
NoNewPrivileges=true
